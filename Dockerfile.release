# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Runtime-only image built from the artifact produced by .github/workflows/build.yml.
#
# The artifact already contains:
#   src/            backend (plain ESM JavaScript)
#   web/            prebuilt admin console
#   config/         defaults
#   node_modules/   production dependencies only
#
# This image does NOT run npm install. It also removes npm/corepack from the
# final stage because the runtime only needs `node src/index.js`.
# ---------------------------------------------------------------------------
FROM node:24-alpine

ARG APP_VERSION=""
ENV DUCKAI_CPA_VERSION=${APP_VERSION}

LABEL org.opencontainers.image.title="duckai-cpa" \
      org.opencontainers.image.description="Duck.ai -> OpenAI-compatible gateway with admin dashboard" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${APP_VERSION}"

ENV NODE_ENV=production \
    DUCKAI_CPA_HOST=0.0.0.0 \
    DUCKAI_CPA_PORT=8787 \
    DUCKAI_CPA_DATA_DIR=/app/data

WORKDIR /app

COPY release/ /app/

# Runtime data directory + non-root ownership. npm/corepack are package-manager
# tooling only and are not needed at runtime.
RUN mkdir -p /app/data \
    && chown -R node:node /app \
    && rm -rf /usr/local/lib/node_modules/npm \
              /usr/local/lib/node_modules/corepack \
              /usr/local/bin/npm \
              /usr/local/bin/npx \
              /usr/local/bin/corepack

USER node

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "const p=process.env.DUCKAI_CPA_PORT||'8787';fetch('http://127.0.0.1:'+p+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/index.js"]

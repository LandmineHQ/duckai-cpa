# Docker 构建上下文忽略清单
# 镜像只需要：package*.json、src/、web/（预构建产物）、config/config.example.json

# ---------- 运行时数据与密钥（必须排除，避免把 token/日志打进镜像） ----------
data/
*.log
.env
.env.*

# ---------- 本地依赖与缓存 ----------
node_modules/
.npm-cache/
.pnpm-store/
*.tsbuildinfo

# ---------- 构建产物 / 源码分发（二进制镜像在容器内自行构建） ----------
dist/
data/tmp*/
coverage/

# ---------- 开发 / 测试 / 侦察产物（不进入镜像） ----------
tests/
docs/
recon-tmp/
recon/
solvetest/
.DS_Store
.git/
.gitignore

# 注意：不要忽略 web/、config/、src/、package*.json，它们是镜像运行所必需的。

# CI release archive (Dockerfile.release uses the extracted release/ directory)
duckai-cpa-release.tar.gz
